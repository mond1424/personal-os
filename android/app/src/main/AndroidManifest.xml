<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
<!-- ══════════ 알림 ══════════ -->

<!-- Android 13+ 런타임 권한. 없으면 알림이 아예 안 뜬다 -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- 잠금화면 점유(FSI). Android 14+는 '알람·통화 앱'만 기본 부여 —
     setAlarmClock으로 실제 알람을 예약하면 그 조건에 부합한다.
     그래도 canUseFullScreenIntent()로 확인하고 설정 페이지로 유도해야 한다 -->
<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

<!-- 잠긴 화면 깨우기 -->
<uses-permission android:name="android.permission.WAKE_LOCK" />

<!-- 진동. 일반 권한이라 자동 부여되지만 **선언이 없으면 vibrate()가 조용히 무시된다** -->
<uses-permission android:name="android.permission.VIBRATE" />


<!-- ══════════ 알람 ══════════ -->

<!-- Android 12~13(API 31~33): 사용자가 설정에서 허용해야 한다 -->
<uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="33" />

<!-- Android 14+(API 34): 알람이 핵심 기능인 앱에 자동 부여.
     사이드로드라 Play 심사가 없고, setAlarmClock이 실제 알람이므로 정당하다 -->
<uses-permission android:name="android.permission.USE_EXACT_ALARM" />

<!-- 재부팅 시 알람 재등록. 없으면 시험 전날 폰을 껐다 켜는 순간
     예약이 전부 사라진다 — 조용한 전면 실패 -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


<!-- ══════════ 포그라운드 서비스 (S1.4) ══════════ -->

<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<!-- Android 14+는 타입 선언 필수. 자기통제 목적 사용 감시는 specialUse -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />


<!-- ══════════ 배터리 ══════════ -->

<!-- 이걸 안 받으면 Doze에서 서비스가 죽는다.
     삼성은 이것만으로 부족 — '절전 시 사용 중지 앱'에서도 빼야 한다(수동) -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />


<!-- ══════════ 감지 (S1.4·S2.5) ══════════ -->

<!-- 서명 권한이라 lint가 막는다. 앱 정보 → 우상단 → '제한된 설정 허용' 후
     설정 > 특별한 앱 액세스 > 사용 정보 접근에서 수동 허용 -->
<uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

<!-- 설치된 앱 목록 조회 (감시목록 대조). Android 11+ -->
<uses-permission
    android:name="android.permission.QUERY_ALL_PACKAGES"
    tools:ignore="QueryAllPackagesPermission" />


<!-- ══════════ 9월 이후 — 오버레이 ══════════ -->
<!-- 지금은 선언만. 권한 요청은 실제로 쓸 때 -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- specialUse 사유 선언은 아래 GuardService <service> 안에 있다 (<application>이 아니다) -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 위젯 딥링크 (T-46 · ADR-041) — `personalos://add-task`.
                 위젯 자신은 컴포넌트를 명시해서 던지므로(AddTaskWidget.tapIntent)
                 이 필터가 없어도 탭은 동작한다. 그래도 두는 이유는 **딥링크만 따로
                 확인할 수 있어야** 하기 때문이다:
                   adb shell am start -a android.intent.action.VIEW -d personalos://add-task
                 그게 안 되면 "위젯이 안 눌린 것"과 "딥링크가 안 닿은 것"을 못 가른다.

                 ⚠️ BROWSABLE을 넣지 않는다 — 넣으면 아무 웹페이지나 이 앱을 열 수 있다.
                    DEFAULT만으로 위 adb 확인과 앱 내부 호출은 그대로 된다.
                 ⚠️ host를 적지 않는다 — 무엇을 여는지는 웹의 `DEEPLINK_ACTIONS`가 정한다.
                    여기에 경로를 박으면 대장이 둘이 되고, 다음 딥링크마다 APK를 다시 깔아야 한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="personalos" />
            </intent-filter>

        </activity>

        <activity
        android:name=".guard.GuardAlertActivity"
        android:exported="false"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:excludeFromRecents="true"
        android:launchMode="singleInstance"
        android:taskAffinity=""
        android:theme="@style/Theme.GuardAlert" />

        <!-- 상시 서비스 — 감지와 **프로세스 생존**.
             specialUse는 Android 14+에서 사유 선언이 필수다. -->
        <service
            android:name=".guard.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="self_control_intervention" />
        </service>

        <!-- 예약된 시각에 시스템이 깨우는 지점 — Guard의 실제 발동. exported 불필요(내부 PendingIntent만) -->
        <receiver
            android:name=".guard.AlarmReceiver"
            android:exported="false" />

        <!-- 재부팅·앱 업데이트로 지워진 AlarmManager 등록을 복구한다.
             둘 다 시스템만 보낼 수 있는 protected broadcast다. -->
        <receiver
            android:name=".guard.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 홈 1×1 "할 일 추가" 위젯 (T-46 · ADR-041).
             Guard와 무관하다 — 발동 경로(alarm·FSI·service)에 아무것도 더하지 않는다.

             ⚠️ `exported="true"`다. APPWIDGET_UPDATE는 **system_server가 보내는** 브로드캐스트라
                보내는 uid가 우리와 다르다. `false`로 두면 등록·재부팅 시 onUpdate가 안 와서
                위젯이 `initialLayout` 그대로 뜨고 **눌러도 아무 일이 없다** — 이 티켓이
                답하려는 질문("눌리는가")이 통째로 무의미해지는 실패다.
                받는 것은 protected broadcast 하나이고, 그 결과는 같은 RemoteViews를 다시 미는 것뿐이다. -->
        <receiver
            android:name=".widget.AddTaskWidget"
            android:label="@string/widget_add_task_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_add_task_info" />
        </receiver>

        <!-- 홈 "오늘 찍기" 위젯 (T-48 · ADR-043) — 크기를 늘리면 찍을 것이 는다.
             T-46의 "+" 위젯과 **별개 위젯이다.** 어느 쪽이 눌리는지가 그 자체로 답이 된다.

             ⚠️ `exported="true"`인 이유는 T-46과 같다 — APPWIDGET_UPDATE는 system_server가
                보내는 protected broadcast라 uid가 우리와 다르다. `false`면 등록 . 재부팅 시
                `onUpdate`가 안 와서 위젯이 `initialLayout` 그대로 뜨고 눌러도 아무 일이 없다.

             ⚠️ **탭과 하루 경계 알람은 여기 filter를 타지 않는다.** 둘 다 `setClass`로 컴포넌트를
                명시한 명시 인텐트라 filter 없이 이 리시버에 그대로 닿는다. filter에 우리 액션을
                적으면 **아무 앱이나 그 액션을 던져 남의 눈금을 찍을 수 있다** — 적지 않는다.

             ⚠️ Guard와 무관하다. 발동 경로(alarm . FSI . service)에 아무것도 더하지 않는다. -->
        <receiver
            android:name=".widget.ScaleWidget"
            android:label="@string/widget_scale_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_scale_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
