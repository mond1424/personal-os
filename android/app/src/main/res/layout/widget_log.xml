<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/layout/widget_log.xml
     홈 3×1 "로그 쓰기" 위젯 (T-49).

     ⚠️ RemoteViews다 — 쓸 수 있는 뷰가 제한되고 `EditText`가 없다.
        **검색창처럼 보이되 여기서는 못 친다.** 탭하면 앱의 입력줄로 가는 것이 전부이고,
        그것은 Google 검색 위젯과 같은 계약이라 거짓말이 아니다.

     ⚠️ 색도 문자열도 리터럴을 박지 않는다. 색은 `@color/…`(다크 짝이 일해야 한다),
        문구는 `@string/…`(한 곳에서 고쳐야 한다). `test/front.mjs`가 둘 다 센다.

     ★ 루트에 id가 있어야 한다. `setOnClickPendingIntent`가 그것을 잡는다 —
        id가 없으면 위젯 전체가 아니라 아무것도 안 눌린다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_log_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:background="@drawable/widget_log_bg"
    android:contentDescription="@string/widget_log_label">

    <TextView
        android:id="@+id/widget_log_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="@string/widget_log_glyph"
        android:textColor="@color/widget_log_dim"
        android:textSize="16sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_log_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/widget_log_hint"
        android:textColor="@color/widget_log_dim"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
