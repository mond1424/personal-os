<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/layout/activity_guard_alert.xml
     잠금화면 위에 뜨는 개입 화면.

     설계 §6.3 — Override는 금지가 아니라 마찰이다.
     절대 잠금은 도구 이탈로 귀결하므로 해제는 **가능하되 비용을 물린다**:
     사유 한 문장(20자) + n초 대기. 사유와 시각은 guard_events에 남아 §6.5의 데이터가 된다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1713"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:minHeight="420dp"
        android:padding="28dp">

        <TextView
            android:id="@+id/guard_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL 3"
            android:textColor="#E0704A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/guard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Guard"
            android:textColor="#EDE7DA"
            android:textSize="26sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.25" />

        <TextView
            android:id="@+id/guard_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#A79E8D"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.55" />

        <!-- 받아들이기 — 마찰 없음. 기본 선택이므로 위에 크게 둔다. -->
        <Button
            android:id="@+id/guard_accept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="알겠습니다"
            android:textColor="#1A1713"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#EDE7DA" />

        <!-- Override 진입 — 눌러야 마찰이 드러난다. 처음부터 보이면 대등한 선택지로 읽힌다. -->
        <Button
            android:id="@+id/guard_override_open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="그래도 계속하기"
            android:textColor="#A79E8D"
            android:textSize="13.5sp" />

        <!-- ── 마찰 영역 (§6.3) ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/guard_friction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="왜 계속하려는지 적어 주세요"
                android:textColor="#A79E8D"
                android:textSize="12.5sp" />

            <!-- 사유는 나중에 자기 자신이 읽는다(§6.5) — 짧게 치고 넘어가지 못하게 한다 -->
            <EditText
                android:id="@+id/guard_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="2"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="#EDE7DA"
                android:textColorHint="#7C7466"
                android:textSize="14.5sp"
                android:background="#221E18"
                android:padding="12dp"
                android:importantForAutofill="no"
                android:hint="한 문장으로" />

            <TextView
                android:id="@+id/guard_reason_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 / 20자"
                android:textColor="#7C7466"
                android:textSize="11.5sp"
                android:gravity="end" />

            <Button
                android:id="@+id/guard_override_go"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="계속하기"
                android:textColor="#EDE7DA"
                android:textSize="14.5sp"
                android:backgroundTint="#3A2A22" />

            <TextView
                android:id="@+id/guard_wait_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#7C7466"
                android:textSize="11.5sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
