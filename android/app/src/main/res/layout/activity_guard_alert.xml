<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/layout/activity_guard_alert.xml
     잠금화면 위에 뜨는 개입 화면. S1.2는 '보이는가'만 확인한다.
     S3.2에서 사유 입력(20자)과 대기 타이머가 여기 들어간다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="#1A1713"
    android:padding="28dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/guard_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEVEL 3"
        android:textColor="#E0704A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.16" />

    <TextView
        android:id="@+id/guard_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Guard"
        android:textColor="#EDE7DA"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.25" />

    <TextView
        android:id="@+id/guard_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#A79E8D"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.55" />

    <Button
        android:id="@+id/guard_dismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="닫기"
        android:textColor="#1A1713"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#EDE7DA" />

    <!-- S3.2 자리: 사유 입력(EditText, 20자 이상) + 대기 타이머 + [그래도 계속하기] -->

</LinearLayout>
